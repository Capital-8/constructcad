<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared MIME info: .ccad files are ConstructCAD projects (RON text). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-constructcad">
    <comment>ConstructCAD project</comment>
    <comment xml:lang="pt_BR">Projeto do ConstructCAD</comment>
    <sub-class-of type="text/plain"/>
    <icon name="constructcad"/>
    <glob pattern="*.ccad"/>
  </mime-type>
</mime-info>
