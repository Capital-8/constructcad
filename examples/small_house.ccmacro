// A small house built with engine commands only (see docs/automation.md).
// ccad --save-as house.ccad script examples/small_house.ccmacro
{"command": "project_info_set", "args": {"name": "Small house", "author": "ccad"}}
{"command": "wall_create", "args": {"start": [0, 0], "end": [8, 0], "height": 2.8}}
{"command": "wall_create", "args": {"start": [8, 0], "end": [8, 6], "height": 2.8}}
{"command": "wall_create", "args": {"start": [8, 6], "end": [0, 6], "height": 2.8}}
{"command": "wall_create", "args": {"start": [0, 6], "end": [0, 0], "height": 2.8}}
{"command": "wall_create", "args": {"start": [4.5, 0], "end": [4.5, 6], "height": 2.8}}
{"command": "door_create", "args": {"point": [2, -0.5]}}
{"command": "door_create", "args": {"point": [4.5, 4.5]}}
{"command": "window_create", "args": {"point": [6.5, -0.5]}}
{"command": "window_create", "args": {"point": [8.5, 3]}}
{"command": "window_create", "args": {"point": [2, 6.5]}}
{"command": "floor_create", "args": {"from_walls": true}}
{"command": "roof_create", "args": {"from_walls": true, "overhang": 0.6}}
{"command": "room_create", "args": {"point": [2, 3], "name": "Living room"}}
{"command": "room_create", "args": {"point": [6, 3], "name": "Bedroom"}}
{"command": "view_create", "args": {"kind": "schedule", "category": "room"}}
{"command": "view_create", "args": {"kind": "section", "start": [-1, 3], "end": [9, 3]}}
